# Caddyfile for local reverse proxy

# nextcloud reverse proxy
{$DOMAIN_CLOUD} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://nextcloud-aio-apache:11000
}

# pterodactyl panel reverse proxy
{$DOMAIN_PANEL} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://pterodactyl-panel:80
}

# pterodactyl node (wings) reverse proxy
{$DOMAIN_NODE} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://192.168.1.5:8085
}

# invoiceninja reverse proxy
{$DOMAIN_NINJA} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    request_body {
        max_size 50MB
    }

    reverse_proxy invoiceninja-web:80 {
        header_up X-Forwarded-Proto https
    }
}

# local ai reverse proxy
{$DOMAIN_AI} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    reverse_proxy open-webui:8080
}

# vaultwarden
{$DOMAIN_VAULT} {
    encode gzip zstd

    # Optional: Restrict /admin to your LAN or WireGuard subnets
    @admin {
        path /admin*
        not remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1
    }
    respond @admin "Access Denied" 403

    # Route directly to the container name on internal port 80
    reverse_proxy vaultwarden:80
}