# Caddyfile for local reverse proxy

# nextcloud reverse proxy
{$DOMAIN_CLOUD} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://nextcloud-aio-apache:11000
}

# pterodactyl panel reverse proxy
{$DOMAIN_PANEL} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://pterodactyl-panel:80
}

# pterodactyl node (wings) reverse proxy
{$DOMAIN_NODE} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
        reverse_proxy http://192.168.1.5:8085
}

# invoiceninja reverse proxy
{$DOMAIN_INVOICE} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    request_body {
        max_size 50MB
    }

    reverse_proxy invoiceninja-web:80 {
        header_up X-Forwarded-Proto https
    }
}

# local ai reverse proxy
{$DOMAIN_AI} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    reverse_proxy open-webui:8080
}

# vaultwarden
{$DOMAIN_VAULT} {
    encode gzip zstd

    # Optional: Restrict /admin to your LAN or WireGuard subnets
    @admin {
        path /admin*
        not remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1
    }
    respond @admin "Access Denied" 403

    # Route directly to the container name on internal port 80
    reverse_proxy vaultwarden:80
}

# nextcloud business reverse proxy
{$DOMAIN_NEXTCLOUD_BUSINESS} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    request_body {
        max_size 100GB
    }

    reverse_proxy nextcloud-business-app:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }

    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
    }

    encode gzip zstd
}

# forgejo reverse proxy
{$DOMAIN_FORGEJO} {
    request_body {
        max_size 5GB
    }
    reverse_proxy forgejo:3000
}

{$DOMAIN_JOOMLA_STAGING} {
    # 1. Require HTTP Basic Authentication
    basic_auth {
        # Format: <username> <hashed-password>
        admin {$CADDY_HASH}
    }

    # 2. Block search engine indexing via HTTP headers
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    # 3. Reverse proxy to your local Joomla container
    reverse_proxy joomla-local-web:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

